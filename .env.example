# Copy to .env and adjust. Never commit .env.
KICK_COMMENTER_IDLE_TIMEOUT_MINUTES=120
KICK_COMMENTER_IDLE_WARNING_MINUTES=5
KICK_COMMENTER_DRY_RUN=true

# From your Kick developer app (Settings > Developer). Keep the secret private.
KICK_COMMENTER_CLIENT_ID=
KICK_COMMENTER_CLIENT_SECRET=
KICK_COMMENTER_REDIRECT_PORT=8765
